# Python
__pycache__
*__pycache__
*.*pyc
*.pyc
*.log*
*.temp
temp.*
*.zip

# Dependencies
venv
.venv

# Environment
.env
.env.*
!.env*.example

# Bruno environments (hold real tokens; templates tracked as .bru.example)
bruno/collections/*/environments/*.bru
!bruno/collections/*/environments/*.bru.example

# Database
*.sqlite3

# Static & Media
staticfiles/
media/

# IDE
.vscode
.windsurf/
*.DS_Store
.DS_Store

# Secrets
credentials.json

# Docker
debug.*
db.*
info.txt

# FUSE open-file artifacts (fuseblk / ntfs-3g)
.fuse_hidden*

# Ignore proposals
openspec/changes/*

# Do not ignore archived proposals
!openspec/changes/archive/


# ignore by default all hiden folders (like agents folders)
.*/

*.db
dev.bru
