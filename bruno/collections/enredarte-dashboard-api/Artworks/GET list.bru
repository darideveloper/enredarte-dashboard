}

docs {
  # GET /apis/artworks/artworks/ — List artworks

  Returns the paginated list of artworks. Requires `Authorization: Token`.

  ## Status codes

  - `200 OK` — success
  - `401 Unauthorized` — missing or invalid token

  ## Response (200)

  ```json
  {
    "count": 1,
    "next": null,
    "previous": null,
    "page": 1,
    "page_size": 12,
    "total_pages": 1,
    "results": [
      {
        "id": 1,
        "slug": "la-columna-rota",
        "is_active": true,
        "sort_order": 0,
        "created_at": "2026-08-17T10:00:00Z",
        "updated_at": "2026-08-17T10:00:00Z",
        "artist": { "id": 1, "slug": "frida-kahlo" },
        "year": 1944,
        "dimensions": "40x30 cm",
        "disciplines": [ { "id": 1, "slug": "painting" } ],
        "techniques": [ { "id": 1, "slug": "oil-painting" } ],
        "themes": [ { "id": 1, "slug": "identity" } ],
        "formats": [ { "id": 1, "slug": "canvas" } ],
        "scales": [ { "id": 1, "slug": "medium" } ],
        "price_mxn": 15000.00,
        "price_usd": 750.00,
        "status": "available",
        "is_highlighted": false,
        "views_count": 42,
        "translations": {
          "es": { "title": "La columna rota", "description": "Óleo sobre lienzo." },
          "en": { "title": "The Broken Column", "description": "Oil on canvas." }
        },
        "images": [
          {
            "id": 1,
            "image": "https://enredarte-dashboard.localhost/media/artworks/columna.webp",
            "alt_es": "La columna rota",
            "alt_en": "The Broken Column",
            "is_primary": true,
            "sort_order": 0
          }
        ],
        "gallery_links": [
          { "id": 1, "gallery": { "id": 1, "slug": "galeria-oaxaca" }, "sort_order": 0 }
        ]
      }
    ]
  }
  ```

  ## Error (401)

  ```json
  {
    "status": "error",
    "message": "Invalid token.",
    "data": {}
  }
  ```
}
