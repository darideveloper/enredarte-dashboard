vars {
  @description('''Base URL of the local dev server, reachable via the portless subdomain started by ./dev.sh. The subdomain derives from the project dir name (enredarte-dashboard). Fallback: http://localhost:8000 (only usable when port 8000 is free, since dev.sh auto-increments on conflict).''')
  base_url: https://enredarte-dashboard.localhost

  @description('''DRF Token placeholder. Create a token in the Django admin (Auth tokens → add token for the machine user) and paste it here. Never commit a real token.''')
  token: <paste-token-here>
}
