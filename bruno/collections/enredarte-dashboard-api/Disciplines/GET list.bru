docs {
  # GET /apis/artworks/disciplines/ — List disciplines
  
  Returns the paginated list of disciplines. Requires `Authorization: Token`.
  
  ## Status codes
  
  - `200 OK` — success
  - `401 Unauthorized` — missing or invalid token
  
  ## Response (200)
  
  ```json
  {
    "count": 1,
    "next": null,
    "previous": null,
    "page": 1,
    "page_size": 12,
    "total_pages": 1,
    "results": [
      {
        "id": 1,
        "slug": "painting",
        "is_active": true,
        "created_at": "2026-08-17T10:00:00Z",
        "updated_at": "2026-08-17T10:00:00Z",
        "translations": {
          "es": { "name": "Pintura" },
          "en": { "name": "Painting" }
        }
      }
    ]
  }
  ```
  
  ## Error (401)
  
  ```json
  {
    "status": "error",
    "message": "Invalid token.",
    "data": {}
  }
  ```
}
