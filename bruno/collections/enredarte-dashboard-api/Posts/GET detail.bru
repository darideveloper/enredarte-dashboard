docs {
  # GET /api/blog/posts/:slug/ — Retrieve a blog post
  
  Returns a single blog post by slug with full bilingual markdown content. Public endpoint.
  Content is full Markdown (headings, lists, tables, code, blockquotes, images, links, hr) in both languages.
  
  ## Status codes
  
  - `200 OK` — success
  - `404 Not Found` — post does not exist or is inactive
  
  ## Response (200)
  
  ```json
  {
    "id": 1,
    "slug": "enredarte-abre-nuevas-salas",
    "author": "Equipo Enredarte",
    "banner_image": "/media/blog/banners/banner-1.jpg",
    "published_at": "2026-08-20T12:00:00Z",
    "title_es": "Enredarte abre nuevas salas de exhibición",
    "title_en": "Enredarte opens new exhibition rooms",
    "description_es": "El museo amplía sus espacios con dos salas dedicadas a la plástica contemporánea mexicana.",
    "description_en": "The museum expands its spaces with two rooms dedicated to contemporary Mexican art.",
    "keywords_es": "museo, salas, exhibición, arte contemporáneo",
    "keywords_en": "museum, rooms, exhibition, contemporary art",
    "content_es": "# Enredarte abre nuevas salas de exhibición\n\nTexto completo en español con formato Markdown (incluye H2/H3, listas, tabla, código, cita, imagen, enlace, regla)...",
    "content_en": "# Enredarte opens new exhibition rooms\n\nFull text in English with Markdown formatting (includes H2/H3, lists, table, code, blockquote, image, link, hr)..."
  }
  ```
  
  ## Error (404)
  
  ```json
  {
    "status": "error",
    "message": "Not found.",
    "data": {}
  }
  ```
}
