docs {
  # GET /api/blog/posts/:slug/ — Retrieve a blog post
  
  Returns a single blog post by slug with full bilingual markdown content. Public endpoint.
  
  ## Status codes
  
  - `200 OK` — success
  - `404 Not Found` — post does not exist or is inactive
  
  ## Response (200)
  
  ```json
  {
    "id": 1,
    "slug": "arte-contemporaneo-oaxaca",
    "author": "Equipo Enredarte",
    "banner_image": "/media/blog/banners/oaxaca.webp",
    "published_at": "2026-08-20T12:00:00Z",
    "title_es": "Arte Contemporáneo en Oaxaca",
    "title_en": "Contemporary Art in Oaxaca",
    "description_es": "Una mirada a la escena artística contemporánea de Oaxaca.",
    "description_en": "A look at Oaxaca's contemporary art scene.",
    "keywords_es": "arte, oaxaca, pintura",
    "keywords_en": "art, oaxaca, painting",
    "content_es": "# Arte Contemporáneo en Oaxaca\n\nTexto completo en español con formato Markdown...",
    "content_en": "# Contemporary Art in Oaxaca\n\nFull text in English with Markdown formatting..."
  }
  ```
  
  ## Error (404)
  
  ```json
  {
    "status": "error",
    "message": "Not found.",
    "data": {}
  }
  ```
}
